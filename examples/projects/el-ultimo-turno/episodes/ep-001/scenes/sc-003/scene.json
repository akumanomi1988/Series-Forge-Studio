  "dialogue": [
    {
      "id": "b8b",
      "actor": "bruno",
      "text": "Voy a sentarme. Para morirme más cómodo.",
      "emotion": "sad",
      "intensity": 0.8,
      "at": 0.45,
      "pauseAfter": 0.4
    },
    {
      "id": "l8",
      "actor": "lara",
      "text": "¿Por qué no me lo has dicho? Otra vez, Bruno.",
      "to": "bruno",
      "emotion": "sad",
      "intensity": 0.7
    },
    {
      "id": "b9",
      "actor": "bruno",
      "text": "Porque era una sorpresa. Le estaba poniendo un módulo para que te hiciera el café.",
      "to": "lara",
      "emotion": "sad",
      "intensity": 0.6,
      "reveals": [
        "modulo-cafe"
      ],
      "gesture": "explain",
      "after": "bruno-se-sienta",
      "offset": -1.6
    },
    {
      "id": "l9",
      "actor": "lara",
      "text": "¿Un robot... que me hace el café?",
      "to": "bruno",
      "emotion": "surprise",
      "intensity": 0.7
    },
    {
      "id": "b10",
      "actor": "bruno",
      "text": "Mañana hace seis años que abrimos el taller. Doble y sin azúcar, ¿no?",
      "to": "lara",
      "emotion": "smile",
      "intensity": 0.6,
      "knowledge": [
        "taller-7"
      ],
      "pauseAfter": 0.6
    },
    {
      "id": "l10",
      "actor": "lara",
      "text": "Eres un desastre, ¿lo sabes?",
      "to": "bruno",
      "emotion": "smile"
    },
    {
      "id": "b11",
      "actor": "bruno",
      "text": "Un desastre con buena memoria.",
      "to": "lara",
      "emotion": "smile",
      "gesture": "shrug",
      "pauseAfter": 0.9
    },
    {
      "id": "l11",
      "actor": "lara",
      "text": "La consola. Lleva un fusible igual, del mismo siglo que tu robot.",
      "to": "bruno",
      "emotion": "determined",
      "intensity": 0.8
    },
    {
      "id": "b12",
      "actor": "bruno",
      "text": "¡Ahí está toda la contabilidad!",
      "to": "lara",
      "emotion": "fear",
      "intensity": 0.9
    },
    {
      "id": "l12",
      "actor": "lara",
      "text": "¿La de los doce mil euros? Que descanse en paz.",
      "to": "bruno",
      "emotion": "smirk",
      "knowledge": [
        "deuda-pasada"
      ],
      "gesture": "dismiss"
    }
  ],
