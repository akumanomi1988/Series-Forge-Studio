  "dialogue": [
    {
      "id": "l3",
      "actor": "lara",
      "text": "¿Y por qué tiene el panel abierto?",
      "to": "bruno",
      "emotion": "smirk",
      "intensity": 0.6,
      "with": "lara-al-robot",
      "offset": 0.2
    },
    {
      "id": "b5",
      "actor": "bruno",
      "text": "Mantenimiento rutinario. Nada grave.",
      "to": "lara",
      "emotion": "nervous",
      "gesture": "nod"
    },
    {
      "id": "l4",
      "actor": "lara",
      "text": "La última vez que dijiste «nada grave», acabamos debiendo doce mil euros.",
      "to": "bruno",
      "emotion": "angry",
      "intensity": 0.6,
      "knowledge": [
        "deuda-pasada"
      ],
      "gesture": "point",
      "pauseAfter": 0.35
    },
    {
      "id": "b6",
      "actor": "bruno",
      "text": "Aquello fue una inversión... con mala suerte.",
      "to": "lara",
      "emotion": "nervous",
      "intensity": 0.8
    },
    {
      "id": "l5",
      "actor": "lara",
      "text": "Bruno... el núcleo está muerto.",
      "to": "bruno",
      "emotion": "worried",
      "reveals": [
        "nucleo-quemado"
      ],
      "after": "lara-al-panel",
      "offset": 0.3
    },
    {
      "id": "b7",
      "actor": "bruno",
      "text": "Muerto es una palabra muy fuerte.",
      "to": "lara",
      "emotion": "nervous",
      "intensity": 0.8
    },
    {
      "id": "b8",
      "actor": "bruno",
      "text": "Eso no es mío.",
      "to": "lara",
      "emotion": "nervous",
      "intensity": 1.1,
      "with": "cae",
      "offset": 0.75
    },
    {
      "id": "l6",
      "actor": "lara",
      "text": "Es el fusible del núcleo, Bruno. Ya no los fabrica nadie.",
      "to": "bruno",
      "emotion": "angry",
      "intensity": 0.5,
      "reveals": [
        "fusible-oculto",
        "sin-repuesto"
      ],
      "with": "lara-recoge",
      "offset": 0.45
    },
    {
      "id": "b9",
      "actor": "bruno",
      "text": "¿Nadie, nadie?",
      "to": "lara",
      "emotion": "worried",
      "intensity": 1.1
    },
    {
      "id": "l7",
      "actor": "lara",
      "text": "Nadie. Y mañana a las ocho nos cierran.",
      "to": "bruno",
      "emotion": "worried",
      "knowledge": [
        "inspeccion-manana"
      ],
      "gesture": "headshake"
    }
  ],
