  "dialogue": [
    {
      "id": "l2",
      "actor": "lara",
      "text": "¿Nada grave? Tiene el núcleo quemado y medio circuito fundido.",
      "to": "bruno",
      "emotion": "angry",
      "intensity": 0.8,
      "after": "lara-encara",
      "offset": -0.3
    },
    {
      "id": "b4",
      "actor": "bruno",
      "text": "Puedo arreglarlo. Solo necesito un poco más de tiempo.",
      "to": "lara",
      "emotion": "determined",
      "gesture": "present",
      "pauseAfter": 0.3
    },
    {
      "id": "l3",
      "actor": "lara",
      "text": "¡Siempre dices lo mismo! Si falla en la inspección, nos cierran el taller.",
      "to": "bruno",
      "emotion": "angry",
      "intensity": 1.1,
      "gesture": "angry-gesture",
      "pauseAfter": 1.3
    },
    {
      "id": "b5",
      "actor": "bruno",
      "text": "Lo sé. Lo sé.",
      "emotion": "sad",
      "after": "bruno-gira-35",
      "offset": 0.2
    },
    {
      "id": "l4",
      "actor": "lara",
      "text": "Vaya, vaya. ¿Y esto qué es, señor nada grave?",
      "to": "bruno",
      "emotion": "smirk",
      "after": "lara-ensena",
      "offset": 0.2,
      "pauseAfter": 0.4
    },
    {
      "id": "b6",
      "actor": "bruno",
      "text": "Eso... es una historia muy larga.",
      "to": "lara",
      "emotion": "nervous",
      "gesture": "shrug",
      "pauseAfter": 0.5
    },
    {
      "id": "l5",
      "actor": "lara",
      "text": "Tengo toda la noche. Empieza a explicar.",
      "to": "bruno",
      "emotion": "smirk",
      "gesture": "hands-on-hips"
    }
  ],
