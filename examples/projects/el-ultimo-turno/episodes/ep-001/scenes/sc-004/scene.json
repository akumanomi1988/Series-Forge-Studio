  "dialogue": [
    {
      "id": "b13",
      "actor": "bruno",
      "text": "Con cuidado, que esa consola es más vieja que tú.",
      "to": "lara",
      "emotion": "worried",
      "with": "lara-a-consola",
      "offset": 0.3
    },
    {
      "id": "l13",
      "actor": "lara",
      "text": "Y tiene mejor carácter.",
      "emotion": "smirk"
    },
    {
      "id": "b14",
      "actor": "bruno",
      "text": "Adiós, contabilidad.",
      "emotion": "sad",
      "intensity": 0.7,
      "with": "consola-off",
      "offset": 0.35
    },
    {
      "id": "b14b",
      "actor": "bruno",
      "text": "¿Y si no es el mismo modelo?",
      "to": "lara",
      "emotion": "worried",
      "with": "lara-vuelve",
      "offset": 0.5
    },
    {
      "id": "l14a",
      "actor": "lara",
      "text": "Entonces mañana vendemos el robot por piezas.",
      "to": "bruno",
      "emotion": "smirk",
      "intensity": 0.7
    },
    {
      "id": "l14",
      "actor": "lara",
      "text": "Toma. Y esta vez, sin sorpresas.",
      "to": "bruno",
      "emotion": "determined",
      "intensity": 0.6,
      "with": "lara-da",
      "offset": -0.3
    },
    {
      "id": "b15",
      "actor": "bruno",
      "text": "¡Eso es, campeón!",
      "emotion": "joy",
      "with": "arranque",
      "offset": 0.35
    },
    {
      "id": "b16",
      "actor": "bruno",
      "text": "¡No, no, no! ¡Otra vez no!",
      "emotion": "fear",
      "intensity": 0.9,
      "after": "chispas-2",
      "offset": -0.2
    },
    {
      "id": "l16",
      "actor": "lara",
      "text": "Espera. Aquí hay un tornillo suelto tocando el núcleo.",
      "emotion": "thinking",
      "reveals": [
        "tornillo-suelto"
      ]
    },
    {
      "id": "l17",
      "actor": "lara",
      "text": "Un tornillo, Bruno. Un tornillo.",
      "to": "bruno",
      "emotion": "smirk",
      "after": "lara-gira-lenta",
      "offset": -0.2
    },
    {
      "id": "b17",
      "actor": "bruno",
      "text": "Te dije que estaba ajustando tornillos.",
      "to": "lara",
      "emotion": "smirk",
      "gesture": "shrug",
      "pauseAfter": 0.5
    },
    {
      "id": "l18",
      "actor": "lara",
      "text": "Anda, apriétalo, genio.",
      "to": "bruno",
      "emotion": "laugh",
      "intensity": 0.7
    },
    {
      "id": "b18",
      "actor": "bruno",
      "text": "¡Diez pasitos, campeón! ¡Mañana, diez pasitos!",
      "emotion": "joy",
      "intensity": 1.1,
      "with": "arranque-2",
      "offset": 1.3
    },
    {
      "id": "b19",
      "actor": "bruno",
      "text": "Y ahora... el módulo del café.",
      "to": "lara",
      "emotion": "smile",
      "gesture": "explain",
      "after": "robot-a-lara",
      "offset": 0.35
    },
    {
      "id": "l19",
      "actor": "lara",
      "text": "Ni se te ocurra.",
      "to": "bruno",
      "emotion": "smirk",
      "intensity": 1,
      "gesture": "point"
    }
  ],
