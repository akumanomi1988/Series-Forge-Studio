  "dialogue": [
    {
      "id": "b1",
      "actor": "bruno",
      "text": "Mañana viene la inspectora, Erre Siete. Das diez pasitos, ella firma y seguimos abiertos.",
      "emotion": "determined",
      "intensity": 0.7,
      "knowledge": [
        "inspeccion-manana"
      ],
      "gesture": "explain",
      "at": 0.5,
      "pauseAfter": 0.5
    },
    {
      "id": "b2",
      "actor": "bruno",
      "text": "Y esta noche, la sorpresa para Lara. Tú, ni una palabra.",
      "emotion": "smirk",
      "direction": "en voz baja, cómplice"
    },
    {
      "id": "b3",
      "actor": "bruno",
      "text": "No, no, no. Tú no te has quemado. Tú estás... descansando.",
      "emotion": "fear",
      "intensity": 0.8,
      "after": "chispas",
      "offset": 0.2
    },
    {
      "id": "l1",
      "actor": "lara",
      "text": "Bruno, ¿por qué huele a cable quemado?",
      "to": "bruno",
      "emotion": "surprise",
      "intensity": 0.6,
      "with": "lara-entra",
      "offset": 0.4
    },
    {
      "id": "b4",
      "actor": "bruno",
      "text": "¿Quemado? Será la cena de alguien. De fuera.",
      "to": "lara",
      "emotion": "nervous",
      "pauseAfter": 0.9
    },
    {
      "id": "l2",
      "actor": "lara",
      "text": "Ya. La cena.",
      "to": "bruno",
      "emotion": "smirk"
    }
  ],
