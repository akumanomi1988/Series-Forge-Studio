  "dialogue": [
    {
      "id": "d15",
      "actor": "dani",
      "text": "Debería irme. Es tarde.",
      "emotion": "sad",
      "to": "vera",
      "at": 0.5
    },
    {
      "id": "v15",
      "actor": "vera",
      "text": "Dani. La lista. Punto dos.",
      "emotion": "determined",
      "to": "dani",
      "after": "dani-se-va",
      "offset": -0.9,
      "intensity": 1.1
    },
    {
      "id": "d16",
      "actor": "dani",
      "text": "¿Cenarías conmigo? Mañana. Sin lámparas.",
      "emotion": "determined",
      "to": "vera",
      "after": "dani-vuelve",
      "offset": -0.3
    },
    {
      "id": "v16",
      "actor": "vera",
      "text": "Llevo tres meses poniéndote poco hielo para que te quedes más rato.",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.2
    },
    {
      "id": "d17",
      "actor": "dani",
      "text": "¿Y por qué no me lo preguntaste tú?",
      "emotion": "surprise",
      "to": "vera"
    },
    {
      "id": "v17",
      "actor": "vera",
      "text": "Porque el cóctel no tenía nombre. Le faltaba alguien que se atreviera a pedirlo.",
      "emotion": "smirk",
      "to": "dani",
      "direction": "en voz baja"
    },
    {
      "id": "d18",
      "actor": "dani",
      "text": "¿Y cómo se llama?",
      "emotion": "joy",
      "to": "vera",
      "after": "luz-vuelve",
      "offset": 0.5
    },
    {
      "id": "v18",
      "actor": "vera",
      "text": "Punto dos.",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.3
    },
    {
      "id": "d19",
      "actor": "dani",
      "text": "¿Y el punto tres? No hablar del tiempo.",
      "emotion": "laugh",
      "to": "vera"
    },
    {
      "id": "v19",
      "actor": "vera",
      "text": "Pues mañana... va a hacer mucho calor.",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.4,
      "pauseAfter": 0.2
    }
  ],
