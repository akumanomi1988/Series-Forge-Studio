  "dialogue": [
    {
      "id": "d7",
      "actor": "dani",
      "text": "Esto es increíble. Es dulce y luego te da una bofetada.",
      "emotion": "joy",
      "to": "vera",
      "after": "bebe",
      "offset": 0.3
    },
    {
      "id": "v7",
      "actor": "vera",
      "text": "Como yo.",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.3
    },
    {
      "id": "d8",
      "actor": "dani",
      "text": "¡Ja! Sí. No. Quiero decir... Hace buena noche, ¿eh? Fresquita.",
      "emotion": "nervous",
      "to": "vera",
      "intensity": 1.2
    },
    {
      "id": "v9",
      "actor": "vera",
      "text": "¿Eso es una lista?",
      "emotion": "surprise",
      "to": "dani",
      "intensity": 0.6
    },
    {
      "id": "d9",
      "actor": "dani",
      "text": "No. Es una servilleta.",
      "emotion": "fear",
      "to": "vera"
    },
    {
      "id": "v10",
      "actor": "vera",
      "text": "Punto tres: no hablar del tiempo. Llevas cuatro segundos incumpliéndolo.",
      "emotion": "smirk",
      "to": "dani",
      "after": "vera-lee",
      "offset": -0.2
    },
    {
      "id": "d10",
      "actor": "dani",
      "text": "Que me trague el suelo. El suelo que yo mismo diseñé.",
      "emotion": "sad",
      "to": "vera"
    },
    {
      "id": "v11",
      "actor": "vera",
      "text": "Lo diseñaste muy bien. ¿Y el punto dos?",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.2
    },
    {
      "id": "d11",
      "actor": "dani",
      "text": "¿Eso... lo he hecho yo?",
      "emotion": "surprise",
      "to": "vera",
      "with": "apagon-sala",
      "offset": 0.7
    },
    {
      "id": "v12",
      "actor": "vera",
      "text": "Salta el automático cada vez que alguien tarda demasiado en decir algo.",
      "emotion": "smirk",
      "to": "dani",
      "direction": "en voz baja"
    },
    {
      "id": "d12",
      "actor": "dani",
      "text": "A oscuras es más fácil. No te veo la cara de saber lo que voy a decir.",
      "emotion": "thinking",
      "to": "vera",
      "direction": "en voz baja"
    },
    {
      "id": "v13",
      "actor": "vera",
      "text": "Entonces dilo antes de que vuelva la luz.",
      "emotion": "smirk",
      "to": "dani",
      "direction": "susurrando",
      "intensity": 1.3
    },
    {
      "id": "d13",
      "actor": "dani",
      "text": "Vale. Vera. Hace tres meses que vengo a revisar la iluminación porque...",
      "emotion": "nervous",
      "to": "vera"
    },
    {
      "id": "d14",
      "actor": "dani",
      "text": "...porque la lámpara de la izquierda zumba. Mañana te la cambio.",
      "emotion": "nervous",
      "to": "vera",
      "pauseAfter": 0.5
    },
    {
      "id": "v14",
      "actor": "vera",
      "text": "La lámpara. Claro.",
      "emotion": "sad",
      "to": "dani",
      "intensity": 0.8
    }
  ],
