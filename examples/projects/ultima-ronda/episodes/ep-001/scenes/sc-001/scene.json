  "dialogue": [
    {
      "id": "v1",
      "actor": "susana",
      "text": "Las doce menos seis. Si llega puntual, me debo diez euros a mí misma.",
      "emotion": "smirk",
      "at": 1.6,
      "direction": "para sí misma"
    },
    {
      "id": "v2",
      "actor": "susana",
      "text": "Doce menos cinco. Pago yo.",
      "emotion": "smile",
      "to": "dani",
      "with": "dani-entra",
      "offset": 0.6
    },
    {
      "id": "d1",
      "actor": "dani",
      "text": "¿Perdón?",
      "emotion": "surprise",
      "to": "susana"
    },
    {
      "id": "v3",
      "actor": "susana",
      "text": "Nada, hablaba con la coctelera. ¿Vienes otra vez a revisar la iluminación?",
      "emotion": "smirk",
      "to": "dani"
    },
    {
      "id": "d2",
      "actor": "dani",
      "text": "Sí. Bueno... con la reforma, la luz cálida a estas horas hay que vigilarla.",
      "emotion": "nervous",
      "to": "susana"
    },
    {
      "id": "v4",
      "actor": "susana",
      "text": "Y la vigilas muy de cerca. Siempre desde el mismo taburete.",
      "emotion": "smirk",
      "to": "dani",
      "after": "dani-se-sienta",
      "offset": -0.4
    },
    {
      "id": "d3",
      "actor": "dani",
      "text": "Es el que tiene mejor ángulo.",
      "emotion": "smile",
      "to": "susana"
    },
    {
      "id": "v5",
      "actor": "susana",
      "text": "¿De la lámpara... o de la camarera?",
      "emotion": "smirk",
      "to": "dani",
      "intensity": 1.2
    },
    {
      "id": "d4",
      "actor": "dani",
      "text": "De la... de la lámpara. Clarísimamente de la lámpara.",
      "emotion": "nervous",
      "to": "susana",
      "intensity": 1.2
    },
    {
      "id": "v6",
      "actor": "susana",
      "text": "Cóctel nuevo. Todavía no tiene nombre.",
      "emotion": "joy",
      "to": "dani",
      "after": "d4",
      "offset": 0.1
    },
    {
      "id": "d5",
      "actor": "dani",
      "text": "¿Por qué no?",
      "emotion": "thinking",
      "to": "susana",
      "after": "v-copa",
      "offset": -0.3
    },
    {
      "id": "v8",
      "actor": "susana",
      "text": "Porque le falta algo. Ya lo descubrirás.",
      "emotion": "smirk",
      "to": "dani"
    },
    {
      "id": "d-lista",
      "actor": "dani",
      "text": "Punto uno, elogiar el cóctel. Punto dos, preguntar. Punto tres, no hablar del tiempo.",
      "emotion": "nervous",
      "after": "dani-saca-lista",
      "offset": 0.1,
      "direction": "en voz baja"
    }
  ],
