  "dialogue": [
    {
      "id": "v1",
      "actor": "susana",
      "to": "dani",
      "text": "Así que esto era una cena tranquila.",
      "emotion": "smirk",
      "at": 0.9
    },
    {
      "id": "d1",
      "actor": "dani",
      "to": "susana",
      "text": "Mi abuela decía que las cenas tranquilas no se recuerdan.",
      "emotion": "smile"
    },
    {
      "id": "v2",
      "actor": "susana",
      "to": "dani",
      "text": "Tu abuela decía muchas cosas.",
      "emotion": "laugh"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "susana",
      "text": "Casi todas mentira. El risotto no le salió nunca.",
      "emotion": "smile"
    },
    {
      "id": "v3",
      "actor": "susana",
      "to": "dani",
      "text": "¿Y entonces por qué lo has hecho?",
      "emotion": "surprise",
      "intensity": 0.7
    },
    {
      "id": "d3",
      "actor": "dani",
      "to": "susana",
      "text": "Porque es lo único suyo que se puede invitar a cenar.",
      "emotion": "thinking",
      "direction": "en voz baja"
    },
    {
      "id": "v4",
      "actor": "susana",
      "to": "dani",
      "text": "Eso ha sido bonito. No lo estropees.",
      "emotion": "smile",
      "direction": "en voz baja"
    },
    {
      "id": "d4",
      "actor": "dani",
      "to": "susana",
      "text": "Vale. Me callo.",
      "emotion": "nervous"
    },
    {
      "id": "v5",
      "actor": "susana",
      "to": "dani",
      "text": "Tampoco tanto.",
      "emotion": "smirk"
    },
    {
      "id": "d5",
      "actor": "dani",
      "to": "susana",
      "text": "Tengo una lista para después de la cena.",
      "emotion": "joy"
    },
    {
      "id": "v6",
      "actor": "susana",
      "to": "dani",
      "text": "Claro que la tienes.",
      "emotion": "smirk"
    },
    {
      "id": "d6",
      "actor": "dani",
      "to": "susana",
      "text": "Punto uno: pedir perdón por el risotto. Punto dos: pedir perdón por mi ex. Punto tres...",
      "emotion": "nervous"
    },
    {
      "id": "v7",
      "actor": "susana",
      "to": "dani",
      "text": "El punto tres lo escribo yo.",
      "emotion": "smirk",
      "intensity": 1.2
    },
    {
      "id": "d7",
      "actor": "dani",
      "to": "susana",
      "text": "¿Y qué pone?",
      "emotion": "surprise"
    },
    {
      "id": "v8",
      "actor": "susana",
      "to": "dani",
      "text": "Repetir.",
      "emotion": "smirk",
      "direction": "susurrando",
      "intensity": 1.3
    },
    {
      "id": "d8",
      "actor": "dani",
      "to": "susana",
      "text": "¿Repetir la cena?",
      "emotion": "joy"
    },
    {
      "id": "v9",
      "actor": "susana",
      "to": "dani",
      "text": "Por Dios, no. La cena no.",
      "emotion": "laugh"
    },
    {
      "id": "v10",
      "actor": "susana",
      "to": "dani",
      "text": "La próxima vez cocino yo.",
      "emotion": "smile"
    },
    {
      "id": "d9",
      "actor": "dani",
      "to": "susana",
      "text": "¿Tú sabes cocinar?",
      "emotion": "surprise"
    },
    {
      "id": "v11",
      "actor": "susana",
      "to": "dani",
      "text": "No. Pero pido muy bien a domicilio.",
      "emotion": "smile",
      "pauseAfter": 0.6
    }
