  "dialogue": [
    {
      "id": "m1",
      "actor": "marga",
      "to": "oscar",
      "text": "Son las dos menos cinco. ¿Tú qué haces aquí?",
      "emotion": "smirk",
      "at": 1.2
    },
    {
      "id": "o1",
      "actor": "oscar",
      "to": "marga",
      "text": "He venido a devolverte la colonia.",
      "emotion": "smile"
    },
    {
      "id": "m2",
      "actor": "marga",
      "to": "oscar",
      "text": "Está vacía.",
      "emotion": "angry",
      "after": "marga-mira"
    },
    {
      "id": "o2",
      "actor": "oscar",
      "to": "marga",
      "text": "Por eso he tardado. Me la he ido echando por el camino.",
      "emotion": "smirk"
    },
    {
      "id": "m3",
      "actor": "marga",
      "to": "oscar",
      "text": "Eres idiota.",
      "emotion": "laugh"
    },
    {
      "id": "o3",
      "actor": "oscar",
      "to": "marga",
      "text": "Pero huelo bien.",
      "emotion": "joy"
    },
    {
      "id": "m4",
      "actor": "marga",
      "to": "oscar",
      "text": "Hueles a gasolinera.",
      "emotion": "smirk"
    },
    {
      "id": "o4",
      "actor": "oscar",
      "to": "marga",
      "text": "A una muy buena.",
      "emotion": "smile"
    },
    {
      "id": "o5",
      "actor": "oscar",
      "to": "marga",
      "text": "¿Me pones algo?",
      "emotion": "smile"
    },
    {
      "id": "m5",
      "actor": "marga",
      "to": "oscar",
      "text": "Agua. Son tres euros.",
      "emotion": "smirk"
    },
    {
      "id": "v1",
      "actor": "susana",
      "to": "marga",
      "text": "Marga. Te debo veinte euros.",
      "emotion": "joy",
      "with": "susana-entra",
      "offset": 1.4
    },
    {
      "id": "m6",
      "actor": "marga",
      "to": "susana",
      "text": "¿Ha sido un desastre?",
      "emotion": "surprise"
    },
    {
      "id": "v2",
      "actor": "susana",
      "to": "marga",
      "text": "El mejor desastre de mi vida.",
      "emotion": "smile"
    },
    {
      "id": "d1",
      "actor": "dani",
      "to": "marga",
      "text": "Y a las diez estaba comiendo tarta, no cacahuetes. Técnicamente has perdido.",
      "emotion": "smirk"
    },
    {
      "id": "m7",
      "actor": "marga",
      "to": "dani",
      "text": "Técnicamente, la tarta la pagué yo.",
      "emotion": "smirk"
    },
    {
      "id": "o6",
      "actor": "oscar",
      "to": "marga",
      "text": "¿Otra apuesta? A que estos dos llegan al punto cuatro.",
      "emotion": "joy"
    },
    {
      "id": "m8",
      "actor": "marga",
      "to": "oscar",
      "text": "Cuarenta a que no.",
      "emotion": "smirk"
    },
    {
      "id": "v3",
      "actor": "susana",
      "to": "marga",
      "text": "Que nadie me pregunte cuál es el punto cuatro.",
      "emotion": "smirk"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "susana",
      "text": "Mañana va a hacer mucho calor.",
      "emotion": "smirk",
      "intensity": 1.3
    },
    {
      "id": "v4",
      "actor": "susana",
      "to": "dani",
      "text": "Eso no estaba en la lista.",
      "emotion": "laugh",
      "pauseAfter": 0.3
    },
    {
      "id": "n1",
      "actor": "dani",
      "voiceOver": true,
      "text": "Nunca supe cuál era el punto cuatro. Pero esa... es otra cena.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor",
      "pauseAfter": 0.8
    }
