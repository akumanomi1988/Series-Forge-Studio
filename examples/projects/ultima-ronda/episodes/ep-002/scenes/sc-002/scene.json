  "dialogue": [
    {
      "id": "o1",
      "actor": "oscar",
      "to": "dani",
      "text": "¡Ha llegado la caballería! ¿Dónde está el enfermo de amor?",
      "emotion": "joy",
      "with": "abre",
      "offset": 0.5
    },
    {
      "id": "d1",
      "actor": "dani",
      "to": "oscar",
      "text": "Óscar, te di la llave para emergencias.",
      "emotion": "nervous"
    },
    {
      "id": "o2",
      "actor": "oscar",
      "to": "dani",
      "text": "Esto es una emergencia. Tienes una cita a las nueve y hueles a cebolla.",
      "emotion": "smirk"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "oscar",
      "text": "Es un sofrito. Es la base del risotto.",
      "emotion": "thinking"
    },
    {
      "id": "o3",
      "actor": "oscar",
      "to": "dani",
      "text": "La base de una cita es el olor. Toma. «Tormenta salvaje». Dos gotas y te tienen que sujetar.",
      "emotion": "smirk",
      "after": "oscar-entra",
      "offset": -0.3
    },
    {
      "id": "d3",
      "actor": "dani",
      "to": "oscar",
      "text": "Aquí pone «no aplicar cerca de una llama».",
      "emotion": "thinking",
      "after": "dani-lee"
    },
    {
      "id": "o4",
      "actor": "oscar",
      "to": "dani",
      "text": "Por eso funciona. Es peligrosa.",
      "emotion": "smirk"
    },
    {
      "id": "d4",
      "actor": "dani",
      "to": "oscar",
      "text": "No necesito colonia. Necesito que no se pegue el arroz. Mi abuela decía: el risotto no se abandona nunca.",
      "emotion": "nervous"
    },
    {
      "id": "o5",
      "actor": "oscar",
      "to": "dani",
      "text": "Tu abuela era una sabia. Como yo. Por eso te he preparado una lista de reproducción.",
      "emotion": "joy"
    },
    {
      "id": "d5",
      "actor": "dani",
      "to": "oscar",
      "text": "¿Qué lista?",
      "emotion": "worried"
    },
    {
      "id": "o6",
      "actor": "oscar",
      "to": "dani",
      "text": "«Noches de pasión, volumen tres». La uno y la dos las quemé con Marga.",
      "emotion": "smirk"
    },
    {
      "id": "d6",
      "actor": "dani",
      "to": "oscar",
      "text": "¿Quién es Marga?",
      "emotion": "surprise"
    },
    {
      "id": "o7",
      "actor": "oscar",
      "to": "dani",
      "text": "Nadie. Una exmujer. Cultura general.",
      "emotion": "sad",
      "intensity": 0.7
    },
    {
      "id": "d7",
      "actor": "dani",
      "to": "oscar",
      "text": "Tampoco necesito música. Susana tiene un bar: escucha música doce horas al día.",
      "emotion": "thinking"
    },
    {
      "id": "o8",
      "actor": "oscar",
      "to": "dani",
      "text": "Precisamente. Hay que sorprenderla. Atiende: la técnica del espejo. Tú haces lo que hace ella. Ella bebe, tú bebes. Ella se ríe, tú te ríes.",
      "emotion": "smirk"
    },
    {
      "id": "d8",
      "actor": "dani",
      "to": "oscar",
      "text": "¿Y si ella se va?",
      "emotion": "worried"
    },
    {
      "id": "o9",
      "actor": "oscar",
      "to": "dani",
      "text": "Tú también te vas. Pero detrás.",
      "emotion": "thinking"
    },
    {
      "id": "d9",
      "actor": "dani",
      "to": "oscar",
      "text": "Eso no es una técnica, Óscar. Eso es una orden de alejamiento.",
      "emotion": "angry",
      "intensity": 0.7
    },
    {
      "id": "o10",
      "actor": "oscar",
      "to": "dani",
      "text": "¡Ja! ¿Ves? Ya estás gracioso. Eso es la colonia.",
      "emotion": "laugh"
    },
    {
      "id": "d10",
      "actor": "dani",
      "to": "oscar",
      "text": "No me he puesto colonia.",
      "emotion": "thinking"
    },
    {
      "id": "o11",
      "actor": "oscar",
      "to": "dani",
      "text": "Te la he echado yo al entrar. Cuando te has dado la vuelta.",
      "emotion": "smirk"
    },
    {
      "id": "d11",
      "actor": "dani",
      "to": "oscar",
      "text": "Por eso me pican los ojos.",
      "emotion": "disgust"
    },
    {
      "id": "o12",
      "actor": "oscar",
      "to": "dani",
      "text": "Eso es la pasión.",
      "emotion": "joy"
    },
    {
      "id": "d12",
      "actor": "dani",
      "to": "oscar",
      "text": "Vale. Escúchame. Esta noche, nada de técnicas. Hago la cena, hablamos y soy yo mismo.",
      "emotion": "determined"
    },
    {
      "id": "o13",
      "actor": "oscar",
      "to": "dani",
      "text": "¿Tú mismo? ¿El de la lámpara?",
      "emotion": "worried"
    },
    {
      "id": "d13",
      "actor": "dani",
      "to": "oscar",
      "text": "Al de la lámpara le ha dicho que sí.",
      "emotion": "determined"
    },
    {
      "id": "o14",
      "actor": "oscar",
      "to": "dani",
      "text": "Ya. Al de la lámpara le dijo que sí a una cena. A ver qué le dice al del risotto.",
      "emotion": "smirk"
    },
    {
      "id": "d14",
      "actor": "dani",
      "to": "oscar",
      "text": "Fuera de mi cocina.",
      "emotion": "angry",
      "pauseAfter": 0.3
    }
  ],
