  "dialogue": [
    {
      "id": "d0",
      "actor": "dani",
      "to": "susana",
      "text": "Será el vecino. El de verdad.",
      "emotion": "nervous",
      "at": 0.5
    },
    {
      "id": "s0",
      "actor": "susana",
      "to": "dani",
      "text": "¿El de las paredes finas? Dile que pase, que ya nos conocemos.",
      "emotion": "smirk"
    },
    {
      "id": "l1",
      "actor": "lucia",
      "to": "dani",
      "text": "¡Dani! ¡Sorpresa! Pasaba por aquí con unos planos y una botella de champán.",
      "emotion": "joy",
      "with": "lucia-entra",
      "offset": 0.9
    },
    {
      "id": "d1",
      "actor": "dani",
      "to": "lucia",
      "text": "Lucía. Estoy... cenando.",
      "emotion": "fear"
    },
    {
      "id": "l2",
      "actor": "lucia",
      "to": "susana",
      "text": "Ah, hola. ¿Tú no eres la del bar?",
      "emotion": "smirk"
    },
    {
      "id": "v1",
      "actor": "susana",
      "to": "lucia",
      "text": "Y tú la del yate.",
      "emotion": "smirk",
      "intensity": 1.3
    },
    {
      "id": "l3",
      "actor": "lucia",
      "to": "dani",
      "text": "¡Me encanta! Dani, cariño, he venido por trabajo. Mi tienda. Tú y yo. Como en los viejos tiempos.",
      "emotion": "laugh"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "lucia",
      "text": "En los viejos tiempos me dejaste por un DJ.",
      "emotion": "sad"
    },
    {
      "id": "l4",
      "actor": "lucia",
      "to": "dani",
      "text": "Y he aprendido mucho. Por ejemplo, que la música electrónica no se baila agarrados.",
      "emotion": "thinking"
    },
    {
      "id": "v2",
      "actor": "susana",
      "to": "lucia",
      "text": "Qué profundo.",
      "emotion": "smirk"
    },
    {
      "id": "l5",
      "actor": "lucia",
      "to": "susana",
      "text": "Lo sé. Tengo medio millón de seguidores que lo confirman.",
      "emotion": "smirk"
    },
    {
      "id": "o1",
      "actor": "oscar",
      "text": "¡Achís! Vale, vale, me rindo. Hola a todos. Soy el vecino.",
      "emotion": "nervous",
      "with": "oscar-sale",
      "offset": 0.4
    },
    {
      "id": "v3",
      "actor": "susana",
      "to": "oscar",
      "text": "El de las paredes finas.",
      "emotion": "smirk"
    },
    {
      "id": "l6",
      "actor": "lucia",
      "to": "oscar",
      "text": "¡Óscar! ¡El de «hola, Lucía»!",
      "emotion": "joy"
    },
    {
      "id": "o2",
      "actor": "oscar",
      "to": "lucia",
      "text": "Hola, Lucía. Hola, novia de Dani. Hola... risotto.",
      "emotion": "nervous"
    },
    {
      "id": "m1",
      "actor": "marga",
      "to": "susana",
      "text": "¡Traigo la tarta y la testigo! ¿Llego tarde al desast...?",
      "emotion": "joy",
      "with": "marga-entra",
      "offset": 1
    },
    {
      "id": "m2",
      "actor": "marga",
      "to": "oscar",
      "text": "¿Óscar?",
      "emotion": "surprise",
      "intensity": 1.4
    },
    {
      "id": "o3",
      "actor": "oscar",
      "to": "marga",
      "text": "¿Marga?",
      "emotion": "fear",
      "intensity": 1.3
    },
    {
      "id": "v4",
      "actor": "susana",
      "to": "marga",
      "text": "¿Os conocéis?",
      "emotion": "surprise"
    },
    {
      "id": "m3",
      "actor": "marga",
      "to": "susana",
      "text": "Cinco años casados. Lo justo para saber que esa colonia se llama Tormenta salvaje y que se compra en una gasolinera.",
      "emotion": "angry"
    },
    {
      "id": "o4",
      "actor": "oscar",
      "to": "marga",
      "text": "En una gasolinera muy buena.",
      "emotion": "sad"
    },
    {
      "id": "d3",
      "actor": "dani",
      "to": "oscar",
      "text": "¿Tu exmujer es Marga? ¿La Marga de la uno y la dos?",
      "emotion": "surprise"
    },
    {
      "id": "o5",
      "actor": "oscar",
      "to": "dani",
      "text": "Por algo las quemé.",
      "emotion": "nervous"
    },
    {
      "id": "l7",
      "actor": "lucia",
      "to": "dani",
      "text": "¡Esto es mejor que un reality! Lo voy a grabar.",
      "emotion": "joy"
    },
    {
      "id": "v5",
      "actor": "susana",
      "to": "lucia",
      "text": "Ni se te ocurra.",
      "emotion": "angry",
      "intensity": 1.1
    },
    {
      "id": "m4",
      "actor": "marga",
      "to": "susana",
      "text": "Me debes veinte euros. Son las diez menos cuarto y esto ya es un desastre.",
      "emotion": "smirk"
    },
    {
      "id": "v6",
      "actor": "susana",
      "to": "marga",
      "text": "Y tú acabas de hablar de tu ex. Estamos en paz.",
      "emotion": "smirk"
    },
    {
      "id": "l8",
      "actor": "lucia",
      "to": "dani",
      "text": "Dani, decide. La tienda, el champán y yo... o esa cena carbonizada.",
      "emotion": "smirk",
      "intensity": 1.2
    },
    {
      "id": "d4",
      "actor": "dani",
      "to": "lucia",
      "text": "Lucía. Tú y yo ya tuvimos nuestra cena. Duró tres años y la pagué yo.",
      "emotion": "thinking",
      "after": "l8",
      "offset": 1.2
    },
    {
      "id": "l9",
      "actor": "lucia",
      "to": "dani",
      "text": "¿Perdona?",
      "emotion": "surprise"
    },
    {
      "id": "d5",
      "actor": "dani",
      "to": "lucia",
      "text": "Te diseño la tienda, si quieres. Con factura. Pero esta noche ceno con Susana. Aunque sea carbón.",
      "emotion": "determined"
    },
    {
      "id": "v7",
      "actor": "susana",
      "to": "dani",
      "text": "Sobre todo si es carbón.",
      "emotion": "smile"
    },
    {
      "id": "l10",
      "actor": "lucia",
      "to": "dani",
      "text": "Vaya. Al de la lámpara se le ha encendido la bombilla.",
      "emotion": "smirk"
    },
    {
      "id": "l10b",
      "actor": "lucia",
      "to": "dani",
      "text": "Me alegro por ti, Dani. De verdad. Aunque me fastidie un montón.",
      "emotion": "sad",
      "intensity": 0.7
    },
    {
      "id": "l10c",
      "actor": "lucia",
      "to": "oscar",
      "text": "Me voy, que tengo un directo a las once. Óscar, ¿me llevas?",
      "emotion": "smile"
    },
    {
      "id": "o6",
      "actor": "oscar",
      "to": "lucia",
      "text": "¡Claro!",
      "emotion": "joy"
    },
    {
      "id": "m5",
      "actor": "marga",
      "to": "oscar",
      "text": "¿Claro?",
      "emotion": "angry",
      "intensity": 1.2
    },
    {
      "id": "o7",
      "actor": "oscar",
      "to": "marga",
      "text": "Claro... que no. Tengo el coche en el taller. Desde hace un año.",
      "emotion": "fear"
    },
    {
      "id": "m6",
      "actor": "marga",
      "to": "oscar",
      "text": "Buena respuesta. Y ahora vete tú también, que me tienes que devolver la colonia. Es mía. Te la regalé yo.",
      "emotion": "smirk"
    },
    {
      "id": "o8",
      "actor": "oscar",
      "to": "marga",
      "text": "¿Me la regalaste tú?",
      "emotion": "surprise"
    },
    {
      "id": "m7",
      "actor": "marga",
      "to": "oscar",
      "text": "En una gasolinera muy buena.",
      "emotion": "smile",
      "pauseAfter": 0.2
    },
    {
      "id": "o9",
      "actor": "oscar",
      "to": "marga",
      "text": "Te la devuelvo mañana. Palabra.",
      "emotion": "smile",
      "with": "oscar-tras",
      "offset": 0.3
    },
    {
      "id": "m8",
      "actor": "marga",
      "to": "oscar",
      "text": "Mañana estará vacía. Te conozco, Óscar.",
      "emotion": "smirk"
    },
    {
