  "dialogue": [
    {
      "id": "d1",
      "actor": "dani",
      "to": "oscar",
      "text": "¿Por qué sigues aquí?",
      "emotion": "angry",
      "at": 1,
      "intensity": 0.6
    },
    {
      "id": "o1",
      "actor": "oscar",
      "to": "dani",
      "text": "Superviso. Como un socorrista: no hago nada, pero si te ahogas, salto.",
      "emotion": "smile"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "oscar",
      "text": "Son las nueve menos cinco. Susana llega a las nueve.",
      "emotion": "nervous"
    },
    {
      "id": "o2",
      "actor": "oscar",
      "to": "dani",
      "text": "Ella llega a las nueve y tú a las doce menos cinco. Sois un reloj estropeado.",
      "emotion": "smirk"
    },
    {
      "id": "d3",
      "actor": "dani",
      "to": "oscar",
      "text": "Contesta tú, que tengo las manos en el arroz.",
      "emotion": "nervous",
      "after": "vibra",
      "offset": -1.2
    },
    {
      "id": "o3",
      "actor": "oscar",
      "text": "¡Consultorio sentimental de Daniel Ferrer, dígame!",
      "emotion": "joy",
      "after": "oscar-oreja"
    },
    {
      "id": "o3b",
      "actor": "oscar",
      "text": "¿Lucía? ¡Lucía Vidal! ¡Cuánto tiempo!",
      "emotion": "surprise"
    },
    {
      "id": "d4",
      "actor": "dani",
      "to": "oscar",
      "text": "No. No, no, no.",
      "emotion": "fear",
      "direction": "en voz baja"
    },
    {
      "id": "o4",
      "actor": "oscar",
      "text": "Sí, aquí está, cocinando. Un risotto. Es una cena para una chica que... que no existe.",
      "emotion": "nervous"
    },
    {
      "id": "d5",
      "actor": "dani",
      "to": "oscar",
      "text": "Cuelga.",
      "emotion": "fear",
      "direction": "susurrando",
      "intensity": 1.2
    },
    {
      "id": "o5",
      "actor": "oscar",
      "text": "¿La dirección? Claro: calle del Olmo, catorce, tercero...",
      "emotion": "smile"
    },
    {
      "id": "d6",
      "actor": "dani",
      "to": "oscar",
      "text": "¡Óscar!",
      "emotion": "angry",
      "intensity": 1.3,
      "direction": "gritando"
    },
    {
      "id": "o6",
      "actor": "oscar",
      "text": "...es lo que le diría a cualquiera, pero tú no eres cualquiera. Venga, un beso.",
      "emotion": "nervous"
    },
    {
      "id": "d7",
      "actor": "dani",
      "to": "oscar",
      "text": "¡Le has dado mi dirección a mi ex!",
      "emotion": "angry",
      "after": "cuelga",
      "offset": 0.1,
      "intensity": 1.2
    },
    {
      "id": "o7",
      "actor": "oscar",
      "to": "dani",
      "text": "Me ha dicho «hola, Óscar». Con ese tono. Tú no sabes lo que es ese tono.",
      "emotion": "worried"
    },
    {
      "id": "d8",
      "actor": "dani",
      "to": "oscar",
      "text": "Lo sé perfectamente. Es el tono con el que me dejó por un DJ.",
      "emotion": "sad"
    },
    {
      "id": "o8",
      "actor": "oscar",
      "to": "dani",
      "text": "Tranquilo, que no va a venir. ¿Qué va a hacer, plantarse en tu casa un sábado por la noche?",
      "emotion": "smile"
    },
    {
      "id": "d9",
      "actor": "dani",
      "to": "oscar",
      "text": "Es exactamente lo que va a hacer.",
      "emotion": "sad"
    },
    {
      "id": "o9",
      "actor": "oscar",
      "to": "dani",
      "text": "¿Huele a quemado o es la Tormenta salvaje?",
      "emotion": "surprise",
      "with": "humo",
      "offset": 1
    },
    {
      "id": "d10",
      "actor": "dani",
      "to": "oscar",
      "text": "¡El risotto! ¡El risotto no se abandona nunca!",
      "emotion": "fear",
      "intensity": 1.3,
      "direction": "gritando"
    },
    {
      "id": "o10",
      "actor": "oscar",
      "to": "dani",
      "text": "Bueno... se ha abandonado un poquito.",
      "emotion": "nervous",
      "pauseAfter": 0.3
    }
  ],
