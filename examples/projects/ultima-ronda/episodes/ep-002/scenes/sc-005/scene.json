  "dialogue": [
    {
      "id": "d0",
      "actor": "dani",
      "to": "oscar",
      "text": "¡Ya está aquí! ¡Al dormitorio!",
      "emotion": "fear",
      "at": 0.6,
      "intensity": 1.2
    },
    {
      "id": "o0",
      "actor": "oscar",
      "to": "dani",
      "text": "Vale, vale. Pero deja la puerta entornada, que tengo que supervisar.",
      "emotion": "worried"
    },
    {
      "id": "d0b",
      "actor": "dani",
      "to": "oscar",
      "text": "¡Y no toques nada!",
      "emotion": "angry",
      "with": "dani-a-puerta",
      "offset": 0.5
    },
    {
      "id": "o0b",
      "actor": "oscar",
      "text": "¡Si aquí solo hay una cama y un flexo!",
      "emotion": "worried",
      "direction": "desde el dormitorio"
    },
    {
      "id": "d0c",
      "actor": "dani",
      "text": "Pues no toques el flexo.",
      "emotion": "nervous",
      "direction": "en voz baja"
    },
    {
      "id": "v1",
      "actor": "susana",
      "to": "dani",
      "text": "Huele a... ¿Qué es eso? ¿Incendio o perfume?",
      "emotion": "surprise",
      "with": "susana-entra",
      "offset": 1.2,
      "gesture": "dismiss"
    },
    {
      "id": "d1",
      "actor": "dani",
      "to": "susana",
      "text": "Las dos cosas. Es una colonia que se llama Tormenta salvaje.",
      "emotion": "nervous"
    },
    {
      "id": "v2",
      "actor": "susana",
      "to": "dani",
      "text": "¿Te la has puesto tú?",
      "emotion": "laugh"
    },
    {
      "id": "d2",
      "actor": "dani",
      "to": "susana",
      "text": "Me la han puesto. Es una historia larga.",
      "emotion": "nervous"
    },
    {
      "id": "v3",
      "actor": "susana",
      "to": "dani",
      "text": "Me gustan las historias largas.",
      "emotion": "smile"
    },
    {
      "id": "d3",
      "actor": "dani",
      "to": "susana",
      "text": "Hoy no hablo del tiempo. Tengo una lista nueva.",
      "emotion": "joy"
    },
    {
      "id": "v4",
      "actor": "susana",
      "to": "dani",
      "text": "Cómo no.",
      "emotion": "smirk"
    },
    {
      "id": "d4",
      "actor": "dani",
      "to": "susana",
      "text": "Punto uno: cocinar algo de mi abuela. Punto dos: no quemarlo.",
      "emotion": "determined"
    },
    {
      "id": "v5",
      "actor": "susana",
      "to": "dani",
      "text": "¿Y qué tal va el punto dos?",
      "emotion": "smirk"
    },
    {
      "id": "d5",
      "actor": "dani",
      "to": "susana",
      "text": "Está... caramelizado. Es una técnica italiana. Muy antigua.",
      "emotion": "nervous"
    },
    {
      "id": "v6",
      "actor": "susana",
      "to": "dani",
      "text": "Como tu abuela.",
      "emotion": "smirk"
    },
    {
      "id": "d6",
      "actor": "dani",
      "to": "susana",
      "text": "Exacto. Siéntate, por favor.",
      "emotion": "joy"
    },
    {
      "id": "s6b",
      "actor": "susana",
      "to": "dani",
      "text": "¿Y tú dónde te sientas?",
      "emotion": "smirk",
      "with": "dani-rodea",
      "offset": 0.3
    },
    {
      "id": "d6b",
      "actor": "dani",
      "to": "susana",
      "text": "Enfrente. Lo he medido: un metro cuarenta. Ni muy cerca ni muy lejos.",
      "emotion": "nervous"
    },
    {
      "id": "s6c",
      "actor": "susana",
      "to": "dani",
      "text": "¿Has medido la mesa?",
      "emotion": "surprise",
      "intensity": 0.7
    },
    {
      "id": "v7",
      "actor": "susana",
      "to": "dani",
      "text": "Pues... está crujiente.",
      "emotion": "thinking",
      "after": "dani-se-sienta",
      "offset": 0.6
    },
    {
      "id": "d7",
      "actor": "dani",
      "to": "susana",
      "text": "El risotto crujiente es tendencia en Milán.",
      "emotion": "nervous"
    },
    {
      "id": "v8",
      "actor": "susana",
      "to": "dani",
      "text": "Dani. Está quemado.",
      "emotion": "laugh"
    },
    {
      "id": "d8",
      "actor": "dani",
      "to": "susana",
      "text": "Está muy quemado. Lo siento. Quería demostrarte que no soy solo el de la lámpara.",
      "emotion": "sad"
    },
    {
      "id": "v9",
      "actor": "susana",
      "to": "dani",
      "text": "A mí me gustaba el de la lámpara.",
      "emotion": "smile",
      "direction": "en voz baja"
    },
    {
      "id": "d9",
      "actor": "dani",
      "to": "susana",
      "text": "¿En serio?",
      "emotion": "surprise"
    },
    {
      "id": "v10",
      "actor": "susana",
      "to": "dani",
      "text": "El de la lámpara me hacía reír. Este... me tiene un poco nerviosa. Y yo no me pongo nerviosa.",
      "emotion": "worried",
      "intensity": 0.8
    },
    {
      "id": "o1",
      "actor": "oscar",
      "text": "¡Achís!",
      "emotion": "surprise",
      "direction": "gritando"
    },
    {
      "id": "v11",
      "actor": "susana",
      "to": "dani",
      "text": "¿Hay alguien en tu dormitorio?",
      "emotion": "surprise"
    },
    {
      "id": "d10",
      "actor": "dani",
      "to": "susana",
      "text": "No. Es el vecino. Las paredes son muy finas.",
      "emotion": "fear"
    },
    {
      "id": "v12",
      "actor": "susana",
      "to": "dani",
      "text": "Tú eres arquitecto.",
      "emotion": "smirk"
    },
    {
      "id": "d11",
      "actor": "dani",
      "to": "susana",
      "text": "Por eso lo sé.",
      "emotion": "nervous"
    },
    {
      "id": "o2",
      "actor": "oscar",
      "text": "¡Perdón, perdón! ¡Que era el botón del volumen!",
      "emotion": "fear",
      "direction": "susurrando",
      "offset": 0.4
    },
    {
      "id": "v13",
      "actor": "susana",
      "to": "dani",
      "text": "¿Y esto qué es?",
      "emotion": "laugh",
      "with": "pasion",
      "offset": 1.8
    },
    {
      "id": "d12",
      "actor": "dani",
      "to": "susana",
      "text": "«Noches de pasión, volumen tres».",
      "emotion": "sad"
    },
    {
      "id": "v14",
      "actor": "susana",
      "to": "dani",
      "text": "¿Y el uno y el dos?",
      "emotion": "smirk",
      "intensity": 1.2
    },
    {
      "id": "d13",
      "actor": "dani",
      "to": "susana",
      "text": "Se quemaron. Como el risotto.",
      "emotion": "nervous"
    },
    {
      "id": "v15",
      "actor": "susana",
      "to": "dani",
      "text": "¿Esperas a alguien más?",
      "emotion": "surprise",
      "after": "timbre",
      "offset": 2
    },
    {
      "id": "d14",
      "actor": "dani",
      "to": "susana",
      "text": "Espero que no.",
      "emotion": "fear",
      "pauseAfter": 0.3
    }
  ],
