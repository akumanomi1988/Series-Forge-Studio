    {
      "id": "l0",
      "actor": "lucia",
      "to": "dani",
      "text": "¡Sorpresa! He traído champán.",
      "emotion": "joy",
      "at": 0.5
    },
    {
      "id": "m0",
      "actor": "marga",
      "to": "oscar",
      "text": "¿Óscar? ¿Qué haces tú aquí?",
      "emotion": "surprise"
    },
    {
      "id": "o0",
      "actor": "oscar",
      "to": "marga",
      "text": "Yo... pasaba por el dormitorio.",
      "emotion": "fear"
    },
    {
      "id": "v0",
      "actor": "susana",
      "to": "dani",
      "text": "Dani... ¿esta era la cena tranquila?",
      "emotion": "surprise",
      "intensity": 0.8
    },
    {
      "id": "s0",
      "actor": "dani",
      "to": "susana",
      "text": "Puedo explicarlo.",
      "emotion": "fear"
    },
    {
      "id": "n1",
      "actor": "dani",
      "voiceOver": true,
      "text": "Ese de ahí soy yo. El que suda.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor"
    },
    {
      "id": "n2",
      "actor": "dani",
      "voiceOver": true,
      "text": "La primera vez que invité a Susana a cenar, pensé que lo difícil iba a ser cocinar.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor"
    },
    {
      "id": "n3",
      "actor": "dani",
      "voiceOver": true,
      "text": "A las diez de la noche tenía el arroz carbonizado, a mi mejor amigo saliendo de mi dormitorio, a mi exnovia con champán... y a la exmujer de mi mejor amigo con una tarta.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor"
    },
    {
      "id": "n4",
      "actor": "dani",
      "voiceOver": true,
      "text": "Mi abuela tenía razón: el risotto no se abandona nunca. Lo que no me explicó es qué se hace con los ex.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor"
    },
    {
      "id": "n5",
      "actor": "dani",
      "voiceOver": true,
      "text": "Para entenderlo, hay que volver tres horas atrás.",
      "emotion": "smile",
      "intensity": 0.7,
      "direction": "narrador, en pasado, tono íntimo y con humor",
      "pauseAfter": 0.4
    }
