  "dialogue": [
    {
      "id": "v0",
      "actor": "susana",
      "to": "marga",
      "text": "¿Qué tal estoy?",
      "emotion": "smile",
      "at": 1.2
    },
    {
      "id": "m0",
      "actor": "marga",
      "to": "susana",
      "text": "Para una cena con risotto, demasiado guapa. Para un incendio, perfecta.",
      "emotion": "smirk"
    },
    {
      "id": "l1",
      "actor": "lucia",
      "to": "marga",
      "text": "¡Hola! Qué sitio tan... íntimo. ¿Hacéis cócteles sin azúcar, sin alcohol y sin gluten?",
      "emotion": "joy",
      "with": "lucia-entra",
      "offset": 1.4
    },
    {
      "id": "m1",
      "actor": "marga",
      "to": "lucia",
      "text": "Eso se llama agua. Son tres euros.",
      "emotion": "smirk"
    },
    {
      "id": "l2",
      "actor": "lucia",
      "to": "marga",
      "text": "¡Me encanta! Busco a alguien: Dani Ferrer. Arquitecto, gafas, habla del tiempo cuando se pone nervioso.",
      "emotion": "laugh"
    },
    {
      "id": "v1",
      "actor": "susana",
      "to": "lucia",
      "text": "¿Y tú eres...?",
      "emotion": "surprise",
      "intensity": 0.7
    },
    {
      "id": "l3",
      "actor": "lucia",
      "to": "susana",
      "text": "Lucía. Su ex. Bueno, su ex de momento.",
      "emotion": "smirk"
    },
    {
      "id": "m2",
      "actor": "marga",
      "to": "susana",
      "text": "La del DJ de Ibiza.",
      "emotion": "disgust",
      "direction": "en voz baja"
    },
    {
      "id": "l4",
      "actor": "lucia",
      "to": "susana",
      "text": "Lo del DJ duró lo que dura una canción de DJ: cuatro minutos, y luego todo el rato lo mismo.",
      "emotion": "smirk"
    },
    {
      "id": "v2",
      "actor": "susana",
      "to": "lucia",
      "text": "¿Y qué quieres de Dani?",
      "emotion": "determined"
    },
    {
      "id": "l5",
      "actor": "lucia",
      "to": "susana",
      "text": "Voy a abrir una tienda aquí al lado y necesito un arquitecto. Y ya que estoy, recuperar al arquitecto.",
      "emotion": "joy"
    },
    {
      "id": "m3",
      "actor": "marga",
      "to": "lucia",
      "text": "Mira, guapa...",
      "emotion": "angry",
      "pauseAfter": 0.05
    },
    {
      "id": "v3",
      "actor": "susana",
      "to": "marga",
      "text": "Marga.",
      "emotion": "determined"
    },
    {
      "id": "v3b",
      "actor": "susana",
      "to": "lucia",
      "text": "Dani tiene planes esta noche.",
      "emotion": "smirk"
    },
    {
      "id": "l6",
      "actor": "lucia",
      "to": "susana",
      "text": "¿Dani? ¿Planes? Dani escribe los planes en una servilleta y luego no los hace.",
      "emotion": "laugh"
    },
    {
      "id": "v4",
      "actor": "susana",
      "to": "lucia",
      "text": "Esta vez los ha hecho.",
      "emotion": "smirk",
      "intensity": 1.2
    },
    {
      "id": "l7",
      "actor": "lucia",
      "to": "susana",
      "text": "Pues habrá que cambiárselos. ¿Sabéis dónde vive ahora?",
      "emotion": "smirk"
    },
    {
      "id": "v5",
      "actor": "susana",
      "to": "lucia",
      "text": "Ni idea.",
      "emotion": "smirk"
    },
    {
      "id": "m4",
      "actor": "marga",
      "to": "lucia",
      "text": "En la otra punta. En otra ciudad. En otro planeta.",
      "emotion": "angry"
    },
    {
      "id": "l8",
      "actor": "lucia",
      "to": "marga",
      "text": "¡Qué graciosa! Da igual, tengo su número. Las ex somos como los impuestos: siempre volvemos.",
      "emotion": "laugh"
    },
    {
      "id": "m5",
      "actor": "marga",
      "to": "susana",
      "text": "Vete ya a esa cena. Y si aparece esa, la tarta que te llevo luego va directa a su cara.",
      "emotion": "angry",
      "with": "lucia-sale",
      "offset": 1
    },
    {
      "id": "v6",
      "actor": "susana",
      "to": "marga",
      "text": "¿Qué tarta?",
      "emotion": "surprise"
    },
    {
      "id": "m6",
      "actor": "marga",
      "to": "susana",
      "text": "La del postre. Una primera cita necesita una tarta y una testigo.",
      "emotion": "smile"
    },
    {
      "id": "v7",
      "actor": "susana",
      "to": "marga",
      "text": "Tú lo que quieres es cotillear.",
      "emotion": "smirk"
    },
    {
      "id": "m7",
      "actor": "marga",
      "to": "susana",
      "text": "Yo lo que quiero es ganar veinte euros. Que no es lo mismo.",
      "emotion": "smirk",
      "pauseAfter": 0.3
    }
  ],
