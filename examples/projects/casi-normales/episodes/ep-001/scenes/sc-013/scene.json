  "dialogue": [
    {
      "id": "l001",
      "actor": "dani",
      "text": "Perdone... ¿Quién me desata?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l002",
      "actor": "ines",
      "text": "¿Usted no es el dueño?",
      "emotion": "neutral",
      "pauseAfter": 0.38
    },
    {
      "id": "l003",
      "actor": "dani",
      "text": "¡Sí!",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l004",
      "actor": "ines",
      "text": "Pues gestione usted la incidencia.",
      "emotion": "neutral",
      "pauseAfter": 0.38
    },
    {
      "id": "l005",
      "actor": "roman",
      "text": "Yo ficho a las doce.",
      "emotion": "neutral",
      "pauseAfter": 0.38
    },
    {
      "id": "l006",
      "actor": "dani",
      "text": "¡PERO QUE ALGUIEN ME QUITE ESTO!",
      "emotion": "angry",
      "direction": "gritando con intensidad",
      "pauseAfter": 0.2
    },
    {
      "id": "l007",
      "actor": "roman",
      "text": "La cena de la señora iba por cuenta de la casa, ¿no?",
      "emotion": "neutral",
      "pauseAfter": 0.38
    },
    {
      "id": "l008",
      "actor": "dani",
      "text": "¿Y qué?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l009",
      "actor": "roman",
      "text": "Entonces el mantel también.",
      "emotion": "neutral",
      "pauseAfter": 0.38
    },
    {
      "id": "l010",
      "actor": "nico-voz",
      "text": "Hay finales que no necesitan una moraleja. Solo necesitan que alguien cierre la puerta.",
      "emotion": "smirk",
      "direction": "voz en off; narración retrospectiva, confidencial, con ironía española",
