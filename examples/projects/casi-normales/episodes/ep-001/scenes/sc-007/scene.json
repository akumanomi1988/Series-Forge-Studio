  "dialogue": [
    {
      "id": "l001",
      "actor": "nico-voz",
      "text": "Hay segundos en los que te das cuenta de que alguien ha cambiado el aire de una habitación. Aquel fue uno. Vera dejó de sonreír y se quedó mirando un punto por encima de mi hombro.",
      "emotion": "smirk",
      "direction": "voz en off; narración retrospectiva, confidencial, con ironía española",
      "pauseAfter": 0.32
    },
    {
      "id": "l002",
      "actor": "vera",
      "text": "Mierda.",
      "emotion": "nervous",
      "direction": "susurrando en voz baja",
      "pauseAfter": 0.38
    },
    {
      "id": "l003",
      "actor": "nico",
      "text": "¿Qué?",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l004",
      "actor": "vera",
      "text": "No mires.",
      "emotion": "nervous",
      "direction": "susurrando en voz baja",
      "pauseAfter": 0.38
    },
    {
      "id": "l005",
      "actor": "nico",
      "text": "¿Dónde?",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l006",
      "actor": "vera",
      "text": "¡Que no mires, gilipollas!",
      "emotion": "nervous",
      "direction": "susurrando en voz baja",
      "pauseAfter": 0.38
    },
    {
      "id": "l007",
      "actor": "nico-voz",
      "text": "Por supuesto, me giré. Había un hombre entrando por la puerta con una camisa naranja tan brillante que podría haber servido para señalizar una carretera en obras.",
      "emotion": "smirk",
      "direction": "voz en off; narración retrospectiva, confidencial, con ironía española",
      "pauseAfter": 0.32
    },
    {
      "id": "l008",
      "actor": "vera",
      "text": "Es mi ex.",
      "emotion": "nervous",
      "direction": "susurrando en voz baja",
      "pauseAfter": 0.38
    },
    {
      "id": "l009",
      "actor": "nico",
      "text": "Ah. Coño.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l010",
      "actor": "vera",
      "text": "Y es el dueño del restaurante.",
      "emotion": "nervous",
      "direction": "susurrando en voz baja",
      "pauseAfter": 0.38
    },
    {
      "id": "l011",
      "actor": "nico",
      "text": "Pues el sitio lo has elegido tú.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l012",
      "actor": "vera",
      "text": "¡Lo has elegido tú, Nico!",
      "emotion": "angry",
      "direction": "gritando con intensidad",
      "pauseAfter": 0.2
    },
    {
      "id": "l013",
      "actor": "nico",
      "text": "Ah. Es verdad.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l014",
      "actor": "dani",
      "text": "¡Vera! ¡Pero bueno! Qué casualidad.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l015",
      "actor": "vera",
      "text": "Dani.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l016",
      "actor": "dani",
      "text": "¿Qué haces aquí?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l017",
      "actor": "vera",
      "text": "Cenando. Se ve bastante bien desde ahí.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l018",
      "actor": "dani",
      "text": "¿Y este quién es?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l019",
      "actor": "nico",
      "text": "Nico. Encantado.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l020",
      "actor": "dani",
      "text": "Dani. El dueño. ¿Sabes que estás en mi restaurante?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l021",
      "actor": "nico",
      "text": "Me lo han comentado varias veces en los últimos diez segundos.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l022",
      "actor": "dani",
      "text": "Qué gracioso. ¿A qué te dedicas?",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l023",
      "actor": "nico",
      "text": "Trabajo con ordenadores.",
      "emotion": "nervous",
      "pauseAfter": 0.38
    },
    {
      "id": "l024",
      "actor": "dani",
      "text": "Ah, informático. Mi sobrino también arregla ordenadores.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l025",
      "actor": "dani",
      "text": "Bueno, ¿qué tomáis? Aquí la especialidad es la carne.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l026",
      "actor": "vera",
      "text": "Lo que hemos pedido, Dani. Gracias.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l027",
      "actor": "dani",
      "text": "Me siento un momento.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l028",
      "actor": "nico-voz",
      "text": "No lo preguntó. Se sentó. Y esa fue la primera vez en mi vida que vi a un hombre hacer una entrada triunfal en una conversación a la que nadie lo había invitado.",
      "emotion": "smirk",
      "direction": "voz en off; narración retrospectiva, confidencial, con ironía española",
      "pauseAfter": 0.32
    },
    {
      "id": "l029",
      "actor": "vera",
      "text": "Dani, estamos en una cita.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    },
    {
      "id": "l030",
      "actor": "dani",
      "text": "Claro, claro. Si es un segundo.",
      "emotion": "smirk",
      "pauseAfter": 0.38
    }
  ],
